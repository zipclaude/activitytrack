root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 100

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_standard_no-tab-indentation = disabled

[*.{xml,toml,yml,yaml,json,md}]
indent_style = space
indent_size = 2
