<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- External calendar sync (M5): the app writes its own events only. -->
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <!-- Voice notes (M3), asked at first use. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Optional online services (A10): Nominatim, OSRM, map tiles. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- M2 location (A9): foreground service while an entry is ACTIVE; background
       access lets it start from notification actions and after a reboot. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- OxygenOS kills background work aggressively; sideloaded, so the direct request is allowed. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <!-- Package visibility (API 30+): speech recognition services for dictation. -->
  <queries>
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
  </queries>

  <application
      android:name=".ActivityTrackApp"
      android:allowBackup="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:localeConfig="@xml/locales_config"
      android:supportsRtl="true"
      android:theme="@style/Theme.ActivityTrack">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data
          android:name="android.app.shortcuts"
          android:resource="@xml/shortcuts" />
    </activity>

    <!-- Notification actions; explicit intents only. -->
    <receiver
        android:name=".notify.ActionReceiver"
        android:exported="false" />

    <!-- Location while an entry is ACTIVE (DESIGN §6.2). -->
    <service
        android:name=".location.LocationService"
        android:exported="false"
        android:foregroundServiceType="location" />

    <!-- Camera captures go to the cache first (DESIGN §8.1). -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
    </provider>

    <!-- Quick Settings tile: WORK/PAUSE toggle (DESIGN §10); active mode, refreshed by the app. -->
    <service
        android:name=".quick.ToggleTileService"
        android:exported="true"
        android:icon="@drawable/ic_cmd_play"
        android:label="@string/app_name"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data
          android:name="android.service.quicksettings.ACTIVE_TILE"
          android:value="true" />
    </service>

    <!-- Home-screen widgets (Glance). -->
    <receiver
        android:name=".quick.StatusWidgetReceiver"
        android:exported="true"
        android:label="@string/widget_status_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_status_info" />
    </receiver>
    <receiver
        android:name=".quick.ToggleWidgetReceiver"
        android:exported="true"
        android:label="@string/widget_toggle_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_toggle_info" />
    </receiver>

    <!-- Single reminder alarm (DESIGN §6.1). -->
    <receiver
        android:name=".reminders.ReminderReceiver"
        android:exported="false" />

    <!-- Re-arm after reboot, update, clock or time-zone change; these system
         broadcasts are exempt from the implicit-broadcast limits. -->
    <receiver
        android:name=".reminders.BootReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>

  </application>
</manifest>
